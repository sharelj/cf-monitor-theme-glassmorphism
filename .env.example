# 纯静态构建（GitHub Pages / 主题商店）时的运行时配置。
# 只在本地 build:github-page 使用；CI 中由仓库 Secrets 注入。

# 后端 Worker 地址；多个用英文逗号分隔（纯 origin，无结尾 /）
API_BASE=https://your-worker.example.com

# 静态页面标题（也会被 /api/config 的 site_title 覆盖）
TITLE=

# 静态页面背景图（可选）
BACKGROUND_IMAGE=

# 追加到 CSP 的第三方域名（可选，纯 origin）
CSP_API=
CSP_STATIC=
